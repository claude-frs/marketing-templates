{#
  Flyer / just-sold-script
  Just Sold data shape: listing (address, beds, baths, sqft, garageSpaces,
  photos) plus sale { soldPriceLabel, soldPrice, side }. soldPrice is
  optional (the seller must agree to show it); side is "seller", "buyer",
  "both" or empty. No features, headline or description. See notes.md.

  Photos: the hero (right of the diagonal), and up to three interiors that
  are not the hero, straddling its lower edge. agentInfo.website is
  optional.

  Optional fields are guarded with {% if %}; never | default().
#}
{%- set l = flyer.listing -%}
{%- set a = flyer.agentInfo -%}
{%- set s = flyer.sale or {} -%}
{%- set sides = { "seller": "Represented the seller", "buyer": "Represented the buyer", "both": "Represented the buyer and seller" } -%}
{%- set side = sides[s.side] if s.side else "" -%}
{%- set ctaHead = flyer.cta.heading if flyer.cta and flyer.cta.heading else "Thinking of selling?" -%}
{%- set ctaSub = flyer.cta.subline if flyer.cta and flyer.cta.subline else "Call me for a free home valuation." -%}
{%- set others = [] -%}
{%- for src in l.galleryImageUrls or [] %}{% if src and src != l.heroImageUrl and others.length < 3 %}{% set _n = others.push(src) %}{% endif %}{% endfor -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Just Sold · {{ l.street }}</title>
  <link rel="stylesheet" href="style.css">
</head>
<body class="jsx">
  <div class="jsx-sheet">
    <div class="jsx-gold"></div>
    <div class="jsx-hero"><img src="{{ l.heroImageUrl }}" alt=""{% if l.heroPositionX %} style="--hero-x: {{ l.heroPositionX }}%"{% endif %}></div>
    <div class="jsx-foot-gold"></div>
    <div class="jsx-trim">

      <img class="jsx-logo" src="assets/c21-masters-black.svg" alt="CENTURY 21 Masters">
      <h1>
        <span class="jsx-just">Just</span>
        <span class="jsx-sold">Sold!</span>
      </h1>
      <p class="jsx-ribbon">Congratulations to the sellers!</p>

      <div class="jsx-facts">
        <div class="jsx-row">
          <img src="assets/icon-pin-gold.svg" alt="">
          <p class="jsx-address">{{ l.street }}<span>{{ l.city }}, {{ l.state }} {{ l.zip }}</span></p>
        </div>
        {%- if s.soldPrice or side %}
        <div class="jsx-row">
          <span class="jsx-dollar">$</span>
          <div>
            {%- if s.soldPrice %}
            <p class="jsx-caption jsx-price__caption">{% if s.soldPriceLabel %}{{ s.soldPriceLabel }}{% else %}Sold for{% endif %}</p>
            <p class="jsx-price__value">{{ s.soldPrice }}</p>
            {%- endif %}
            {%- if side %}<p class="jsx-side">{{ side }}</p>{% endif %}
          </div>
        </div>
        {%- endif %}
        <ul class="jsx-stats">
          {%- if l.beds %}<li class="jsx-stat"><i><img src="assets/icon-bed-white.svg" alt=""></i><b>{{ l.beds }}</b><span>{% if l.beds == "1" %}Bed{% else %}Beds{% endif %}</span></li>{% endif %}
          {%- if l.baths %}<li class="jsx-stat"><i><img src="assets/icon-bath-white.svg" alt=""></i><b>{{ l.baths }}</b><span>{% if l.baths == "1" %}Bath{% else %}Baths{% endif %}</span></li>{% endif %}
          {%- if l.sqft %}<li class="jsx-stat"><i><img src="assets/icon-sqft-white.svg" alt=""></i><b>{{ l.sqft }}</b><span>Sq Ft</span></li>{% endif %}
          {%- if l.garageSpaces %}<li class="jsx-stat"><i><img src="assets/icon-garage-white.svg" alt=""></i><b>{{ l.garageSpaces }}-Car</b><span>Garage</span></li>{% endif %}
        </ul>
      </div>

      {%- if others.length %}
      <div class="jsx-inside">
        {%- for src in others %}
        <div><img src="{{ src }}" alt=""></div>
        {%- endfor %}
      </div>
      {%- endif %}

      <div class="jsx-cheer">
        <p class="jsx-cheer__word">Congratulations</p>
        <p class="jsx-cheer__to">to the new owners</p>
        <p class="jsx-cheer__ask"><b>{{ ctaHead }}</b>{{ ctaSub }}</p>
      </div>

      <div class="jsx-agent">
        <div class="jsx-agent__photo">
          {%- if a.headshotUrl %}<img src="{{ a.headshotUrl }}" alt="{{ a.fullName }}">{% endif -%}
        </div>
        <div>
          <p class="jsx-agent__name">{{ a.fullName }}</p>
          <p class="jsx-agent__credential">{% if a.jobTitle %}{{ a.jobTitle }}{% else %}Realtor®{% endif %}{% if a.dre %} | DRE #{{ a.dre }}{% endif %}</p>
        </div>
      </div>
      <ul class="jsx-reach">
        {%- if a.phone %}<li><i><img src="assets/icon-phone-white.svg" alt=""></i><b>{{ a.phone }}</b><span>Call or text</span></li>{% endif %}
          {%- if a.email %}<li><i><img src="assets/icon-email-white.svg" alt=""></i><b>{{ a.email | escape | replace("@", "@<wbr>") | safe }}</b><span>Email me</span></li>{% endif %}
          {%- if a.website %}<li><i><img src="assets/icon-globe-white.svg" alt=""></i><b>{{ a.website | escape | replace(".", "<wbr>.") | safe }}</b><span>Visit my website</span></li>{% endif %}
      </ul>

      <div class="jsx-legal">
        <img src="assets/equal-housing-black.png" alt="Equal Housing Opportunity">
        <img src="assets/realtor-black.png" alt="REALTOR®">
        {# Word for word from brand/legal-text.md (Flyers). #}
        <p>Each office is Independently Owned &amp; Operated | Broker DRE# 01849354</p>
      </div>

    </div>
  </div>
</body>
</html>
